{
  "name": "@atlas/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput --incremental & node --watch dist/main.js)",
    "start": "node dist/main.js",
    "sync": "tsx scripts/sync.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlas/ai": "workspace:*",
    "@atlas/config": "workspace:*",
    "@atlas/connector-aws": "workspace:*",
    "@atlas/connector-bitbucket": "workspace:*",
    "@atlas/connector-github": "workspace:*",
    "@atlas/connector-sdk": "workspace:*",
    "@atlas/db": "workspace:*",
    "@atlas/ingest": "workspace:*",
    "@fastify/websocket": "^11.2.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-fastify": "^11.0.1",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
