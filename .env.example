# Copy to .env (gitignored). See docs/17 §6.

# Postgres. Local docker-compose default, or your Supabase pooler connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/atlas

# Supabase (set when wiring Auth/Storage — docs/12, docs/17). Service role key is
# server-only and must never reach the client (docs/13).
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
