# Copy to .env (gitignored). See docs/17 §6.

# Postgres. Local docker-compose default, or your Supabase pooler connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/atlas

# Supabase Auth (docs/12 §2–3). The API verifies user JWTs against Supabase's
# JWKS (ES256) derived from SUPABASE_URL — no shared secret needed. Service role
# key is server-only and must never reach the client (docs/13). SUPABASE_JWT_SECRET
# is the HS256 fallback only (projects without asymmetric signing keys).
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=

# Web (Next.js) — public client config (inlined into the browser bundle; public only).
# Atlas uses uncommon ports to avoid clashing with other local projects:
# API on :4290, web dev server on :4291.
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_API_URL=http://localhost:4290

# Runtime
NODE_ENV=development
PORT=4290
LOG_LEVEL=info
